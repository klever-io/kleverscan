# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
# A coverage run pointed elsewhere still leaves generated output behind: one
# such directory reached a commit at 17,812 lines before this line existed.
/cov*/

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
.vscodeignore
tsconfig.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/temp

# local env files
.env
.env.local
# .env.development.local
.env.test.local
.env.production.local
.idea
.vscode
# vercel
.vercel
.history
